# Security headers — applied by Netlify to freizy.com and stays.freizy.com.
# Scripts, fonts and analytics are all first-party now (Plausible is proxied
# via _redirects), so script-src/font-src need no third-party origins.
# `unsafe-inline` remains for style only: the static product pages use inline
# <style> blocks and React sets inline style attributes.
# CSP reports go to the first-party Netlify edge function via `report-uri`.
# `report-to` is deliberately omitted: when both are present browsers ignore
# `report-uri`, and report-to delivery proved unreliable in testing, so a
# misconfigured endpoint would silence every report.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://api.web3forms.com; media-src 'self'; manifest-src 'self'; upgrade-insecure-requests; report-uri /api/csp-report
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site
  X-Permitted-Cross-Domain-Policies: none

# Fingerprinted build assets are safe to cache for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts are immutable too (filenames are content-hashed by Google).
/fonts/files/*
  Cache-Control: public, max-age=31536000, immutable

/products/freizy-stays/fonts/files/*
  Cache-Control: public, max-age=31536000, immutable

# Stays is also served at the root of stays.freizy.com, so cover both the
# apex path and the rewritten subdomain path. Images/logo are versioned with
# ?v= in the markup, so a year is safe; JS/CSS keep a day and revalidate.
/products/freizy-stays/public/images/*
  Cache-Control: public, max-age=31536000, immutable
/public/images/*
  Cache-Control: public, max-age=31536000, immutable

/products/freizy-stays/public/logo.webp
  Cache-Control: public, max-age=31536000, immutable
/logo.webp
  Cache-Control: public, max-age=31536000, immutable

/products/freizy-stays/stays.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/stays.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/products/freizy-stays/fonts.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/fonts.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
