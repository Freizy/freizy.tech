# Web3Forms access key (ACTIVE form backend).
# Get one at https://web3forms.com — submit your email, the key arrives
# in your inbox. Public-safe by design. NOTE: VITE_ vars bake in at build
# time, so set this on the host and redeploy for it to take effect.
VITE_WEB3FORMS_KEY="34df9cc1-40e3-4b9b-a0d1-da380901f440"

# --- Serverless upgrade path (api/contact.ts). Not used while Web3Forms
# --- is active. Uncomment when switching over.
# Resend API key. Create one at https://resend.com/api-keys
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Where enquiry emails go. Defaults to info@freizy.com if unset.
CONTACT_TO="info@freizy.com"

# Verified sender identity. Must be a domain verified in Resend
# (domain settings give you the DNS records to add).
CONTACT_FROM="website@freizy.com"
